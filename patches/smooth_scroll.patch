+bool DiscreteScrollAnimation::handle(int delta) {
+	if (!delta) {
+		return true;
+	}
+	auto current = _callbacks.position();
+	if (_animation.animating()
+		&& _lastApplied >= 0
+		&& current != _lastApplied) {
+		stop();
+		current = _callbacks.position();
+	}
+	const auto remaining = _target - current;
+	const auto sameDirection = _animation.animating()
+		&& remaining
+		&& ((remaining > 0) == (delta > 0));
+	const auto origin = sameDirection ? _target : current;
+	const auto target = _callbacks.clamp(origin + delta * 2);
+	if (target == current) {
+		stop();
+		return true;
+	}
+	_target = target;
+	_lastApplied = current;
+	_animation.start([this](float64 value) {
+		if (_callbacks.position() != _lastApplied) {
+			stop();
+			return;
+		}
+		const auto expected = base::SafeRound(value);
+		_lastApplied = expected;
+		_callbacks.apply(expected);
+	}, current, target, kDiscreteScrollDuration, anim::easeOutCubic);
+	_animation.setFinishedCallback([this] { _lastApplied = -1; });
+	return true;
+}
+
+void DiscreteScrollAnimation::stop() {
+	_animation.stop();
+	_lastApplied = -1;
+}
