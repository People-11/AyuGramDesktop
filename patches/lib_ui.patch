+
+// A notch only moves the target, and a spring follows it every frame.
+// Restarting an ease on each notch instead resets the speed to its peak,
+// so a spinning wheel scrolls in a sawtooth at the notch rate.
+bool DiscreteScrollAnimation::handle(int delta) {
+	if (!delta) {
+		return true;
+	}
+	const auto current = _callbacks.position();
+	if (_animation.animating() && current != _lastApplied) {
+		stop();
+	}
+	if (!_animation.animating()) {
+		_position = current;
+		_velocity = 0.;
+		_target = current;
+		_lastApplied = current;
+		_lastTime = crl::now();
+	}
+	const auto remaining = _target - current;
+	const auto sameDirection = remaining
+		&& ((remaining > 0) == (delta > 0));
+	_target = _callbacks.clamp((sameDirection ? _target : current) + delta);
+	if (!_animation.animating() && _target != current) {
+		_animation.start();
+	}
+	return true;
