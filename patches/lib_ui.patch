+
+bool DiscreteScrollAnimation::step(crl::time now) {
+	if (_callbacks.position() != _lastApplied) {
+		stop();
+		return false;
+	}
+	const auto dt = float64(std::max(now - _lastTime, crl::time(0)));
+	_lastTime = now;
+
+	// Closed form, so it stays exact however long a frame took.
+	const auto w = kDiscreteScrollOmega;
+	const auto offset = _position - _target;
+	const auto c = _velocity + w * offset;
+	const auto decay = std::exp(-w * dt);
+	const auto left = (offset + c * dt) * decay;
+	_velocity = (_velocity - w * c * dt) * decay;
+	_position = _target + left;
+
+	const auto finished = (std::abs(left) < 0.5)
+		&& (std::abs(_velocity) < 0.01);
+	const auto value = _callbacks.clamp(finished
+		? _target
+		: int(base::SafeRound(_position)));
+	_lastApplied = value;
+	_callbacks.apply(value);
+	if (finished) {
+		_lastApplied = -1;
+	}
+	return !finished;
+}
+
+void DiscreteScrollAnimation::stop() {
+	_animation.stop();
+	_velocity = 0.;
+	_lastApplied = -1;
+}
